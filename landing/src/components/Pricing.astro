<script>
  const toggleBtn = document.getElementById('toggle-switch');
  const toggleKnob = document.getElementById('toggle-knob');
  const mensualLabel = document.getElementById('mensual-label');
  const anualLabel = document.getElementById('anual-label');
  let isAnnual = false;

  toggleBtn?.addEventListener('click', () => {
    isAnnual = !isAnnual;
    if (isAnnual) {
      toggleKnob?.classList.replace('translate-x-0', 'translate-x-6');
      toggleBtn?.classList.replace('bg-primary-600', 'bg-primary-700');
      mensualLabel?.classList.replace('text-primary-600', 'text-surface-500');
      mensualLabel?.classList.replace('font-semibold', 'font-medium');
      anualLabel?.classList.replace('text-surface-500', 'text-primary-600');
      anualLabel?.classList.replace('font-medium', 'font-semibold');
    } else {
      toggleKnob?.classList.replace('translate-x-6', 'translate-x-0');
      toggleBtn?.classList.replace('bg-primary-700', 'bg-primary-600');
      mensualLabel?.classList.replace('text-surface-500', 'text-primary-600');
      mensualLabel?.classList.replace('font-medium', 'font-semibold');
      anualLabel?.classList.replace('text-primary-600', 'text-surface-500');
      anualLabel?.classList.replace('font-semibold', 'font-medium');
    }
    document.querySelectorAll('.mensual-price').forEach(el => {
      (el as HTMLElement).classList.toggle('hidden', isAnnual);
    });
    document.querySelectorAll('.anual-price').forEach(el => {
      (el as HTMLElement).classList.toggle('hidden', !isAnnual);
    });
  });
</script>
