---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AulaPro - Gestion Escolar Inteligente | Guatemala',
  description = 'El software de gestion escolar mas completo de Guatemala. Automatiza cobros, calificaciones, tareas y comunicacion con padres. Prueba gratis 14 dias.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#16a34a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://aulapro.totalappgt.online" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://aulapro.totalappgt.online/og-image.png" />
    <meta property="og:site_name" content="AulaPro" />
    <meta property="og:locale" content="es_GT" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title}</title>
  </head>
  <body class="bg-white text-surface-900 font-sans antialiased min-h-screen flex flex-col">
    <header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 lg:h-20">
          <a href="/" class="flex items-center gap-2.5 font-extrabold text-2xl text-surface-900 no-underline hover:opacity-90 transition-opacity">
            <span class="w-9 h-9 bg-primary-600 rounded-lg flex items-center justify-center text-white text-lg leading-none">A</span>
            AulaPro
          </a>
          <div class="hidden lg:flex items-center gap-8">
            <a href="#funcionalidades" class="text-sm font-medium text-surface-600 hover:text-primary-600 transition-colors no-underline">Funcionalidades</a>
            <a href="#precios" class="text-sm font-medium text-surface-600 hover:text-primary-600 transition-colors no-underline">Precios</a>
            <a href="#faq" class="text-sm font-medium text-surface-600 hover:text-primary-600 transition-colors no-underline">FAQ</a>
          </div>
          <div class="flex items-center gap-3">
            <a href="https://totalappgt.online/login" class="hidden sm:inline-flex items-center gap-2 bg-white hover:bg-gray-50 text-surface-700 border border-surface-200 px-4 py-2.5 rounded-lg text-sm font-semibold transition-all shadow-sm hover:shadow no-underline">
              Iniciar Sesion
            </a>
            <a href="https://totalappgt.online/registro" class="inline-flex items-center gap-2 bg-primary-600 hover:bg-primary-700 text-white px-5 py-2.5 rounded-lg text-sm font-semibold transition-all shadow-sm hover:shadow-md no-underline">
              Probar Gratis 14 Dias
            </a>
            <button id="mobile-menu-btn" class="lg:hidden inline-flex items-center justify-center p-2 rounded-lg text-surface-600 hover:text-surface-900 hover:bg-surface-100 transition-colors" aria-label="Abrir menu">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="menu-icon-open"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
          </div>
        </div>
        <div id="mobile-menu" class="lg:hidden hidden pb-4">
          <div class="flex flex-col gap-2 bg-white rounded-xl shadow-lg border border-surface-200 p-4">
            <a href="#funcionalidades" class="px-4 py-3 rounded-lg text-sm font-medium text-surface-700 hover:bg-surface-50 hover:text-primary-600 transition-colors no-underline">Funcionalidades</a>
            <a href="#precios" class="px-4 py-3 rounded-lg text-sm font-medium text-surface-700 hover:bg-surface-50 hover:text-primary-600 transition-colors no-underline">Precios</a>
            <a href="#faq" class="px-4 py-3 rounded-lg text-sm font-medium text-surface-700 hover:bg-surface-50 hover:text-primary-600 transition-colors no-underline">FAQ</a>
            <hr class="border-surface-200" />
            <a href="https://totalappgt.online/login" class="px-4 py-3 rounded-lg text-sm font-medium text-surface-700 hover:bg-surface-50 transition-colors no-underline">Iniciar Sesion</a>
          </div>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-surface-900 text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 lg:gap-12">
          <div>
            <h3 class="font-semibold text-sm text-surface-400 uppercase tracking-wider mb-4">Producto</h3>
            <ul class="space-y-3">
              <li><a href="#funcionalidades" class="text-surface-300 hover:text-white transition-colors text-sm no-underline">Funcionalidades</a></li>
              <li><a href="#precios" class="text-surface-300 hover:text-white transition-colors text-sm no-underline">Precios</a></li>
              <li><a href="#" class="text-surface-300 hover:text-white transition-colors text-sm no-underline">API</a></li>
              <li><a href="#" class="text-surface-300 hover:text-white transition-colors text-sm no-underline">Seguridad</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-sm text-surface-400 uppercase tracking-wider mb-4">Empresa</h3>
            <ul class="space-y-3">
              <li><a href="#" class="text-surface-300 hover:text-white transition-colors text-sm no-underline">Sobre Nosotros</a></li>
              <li><a href="#" class="text-surface-300 hover:text-white transition-colors text-sm no-underline">Blog</a></li>
              <li><a href="#" class="text-surface-300 hover:text-white transition-colors text-sm no-underline">Contacto</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-sm text-surface-400 uppercase tracking-wider mb-4">Legal</h3>
            <ul class="space-y-3">
              <li><a href="#" class="text-surface-300 hover:text-white transition-colors text-sm no-underline">Terminos</a></li>
              <li><a href="#" class="text-surface-300 hover:text-white transition-colors text-sm no-underline">Privacidad</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-sm text-surface-400 uppercase tracking-wider mb-4">Contacto</h3>
            <ul class="space-y-3">
              <li class="text-surface-300 text-sm flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                Guatemala, C.A.
              </li>
              <li><a href="mailto:info@totalappgt.online" class="text-surface-300 hover:text-white transition-colors text-sm no-underline">info@totalappgt.online</a></li>
              <li><a href="https://wa.me/50258309505" class="text-surface-300 hover:text-green-400 transition-colors text-sm inline-flex items-center gap-1.5 no-underline">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                WhatsApp
              </a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="border-t border-surface-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
            <p class="text-surface-400 text-sm">&copy; 2026 AulaPro. Todos los derechos reservados.</p>
            <p class="text-surface-500 text-sm">Hecho en Guatemala</p>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const navbar = document.getElementById('navbar');
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      window.addEventListener('scroll', () => {
        if (window.scrollY > 20) {
          navbar?.classList.add('bg-white/95', 'backdrop-blur-md', 'shadow-sm', 'border-b', 'border-surface-100');
          navbar?.classList.remove('bg-transparent');
        } else {
          navbar?.classList.remove('bg-white/95', 'backdrop-blur-md', 'shadow-sm', 'border-b', 'border-surface-100');
          navbar?.classList.add('bg-transparent');
        }
      });

      mobileBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
      });

      document.querySelectorAll('#mobile-menu a').forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu?.classList.add('hidden');
        });
      });
    </script>
  </body>
</html>
