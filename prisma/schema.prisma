generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  SUPERADMIN
  ADMIN_COLEGIO
  PROFESOR
  PADRE
  ALUMNO
}

enum EstadoColegio {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum PlanColegio {
  STARTER
  PRO
  BUSINESS
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  VERIFICANDO
  VENCIDO
}

enum EstadoTarea {
  PENDIENTE
  ENTREGADO
  CALIFICADO
  TARDE
}

enum TipoAsistencia {
  PRESENTE
  AUSENTE
  TARDE
  EXCUSA
}

enum TipoAnuncio {
  GENERAL
  GRADO
  SECCION
  URGENTE
}

enum FrecuenciaNotificacion {
  UNA_SOLA_VEZ
  DIARIA
  SEMANAL
  MENSUAL
}

model Colegio {
  id                      String        @id @default(cuid())
  nombre                  String
  direccion               String?
  telefono                String?
  emailAdmin              String        @unique
  logoUrl                 String?
  plan                    PlanColegio   @default(STARTER)
  estado                  EstadoColegio @default(TRIAL)
  trialEndsAt             DateTime?
  recurrenteAccountId     String?
  stripeSubscriptionId    String?
  config                  Json          @default("{}")
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  usuarios     Usuario[]
  alumnos      Alumno[]
  grados       Grado[]
  horarios     Horario[]
  materias     Materia[]
  tareas       Tarea[]
  asistencias  Asistencia[]
  anuncios     Anuncio[]
  mensajes     Mensaje[]
  calificaciones Calificacion[]
  mensualidades  Mensualidad[]
  documentos   Documento[]
  pagos        PagoCheckout[]
  entregasTarea EntregaTarea[]
  notificaciones NotificacionProgramada[]
  cursos       Curso[]
  materiales   Material[]
  muroPosts    MuroPost[]
  sesiones     SesionEnVivo[]
  evaluaciones Evaluacion[]
  intentosEvaluacion IntentoEvaluacion[]

  @@index([emailAdmin])
  @@index([estado])
}

model Usuario {
  id            String     @id @default(cuid())
  colegioId     String
  email         String     @unique
  passwordHash  String
  rol           RolUsuario
  nombre        String
  telefono      String?
  activo        Boolean    @default(true)
  avatarUrl     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  colegio            Colegio         @relation(fields: [colegioId], references: [id])
  gradoGuia          Grado[]
  materiasImparte    Materia[]
  tareasCreadas      Tarea[]         @relation("TareaCreador")
  asistenciasReg     Asistencia[]    @relation("AsistenciaRegistrador")
  anunciosCreados    Anuncio[]       @relation("AnuncioCreador")
  mensajesEnviados   Mensaje[]       @relation("MensajeRemitente")
  mensajesRecibidos  Mensaje[]       @relation("MensajeDestinatario")
  calificacionesReg  Calificacion[]
  documentosCreados  Documento[]
  alumnosResponsable Alumno[]        @relation("AlumnoResponsable")
  notificacionesCreadas NotificacionProgramada[] @relation("NotificacionCreador")
  cursosProfesor     Curso[]         @relation("CursoProfesor")
  materialesCreados  Material[]
  muroPosts          MuroPost[]
  muroComentarios    MuroComentario[]
  sesionesCreadas    SesionEnVivo[]
  evaluacionesCreadas Evaluacion[]   @relation("EvaluacionCreador")
  intentosEvaluacion IntentoEvaluacion[]

  @@unique([colegioId, email])
  @@index([colegioId])
  @@index([rol])
}

model Alumno {
  id            String   @id @default(cuid())
  colegioId     String
  codigo        String
  cui           String?
  nombre        String
  apellido      String?
  gradoId       String?
  fechaNacimiento DateTime?
  direccion     String?
  responsableId String?
  qrToken       String?  @unique
  activo        Boolean  @default(true)
  fotoUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  colegio       Colegio          @relation(fields: [colegioId], references: [id])
  grado         Grado?           @relation(fields: [gradoId], references: [id])
  responsable   Usuario?         @relation("AlumnoResponsable", fields: [responsableId], references: [id])
  entregas      EntregaTarea[]
  asistencias   Asistencia[]
  calificaciones Calificacion[]
  mensualidades Mensualidad[]

  @@unique([colegioId, codigo])
  @@index([colegioId, gradoId])
}

model Grado {
  id            String   @id @default(cuid())
  colegioId     String
  nombre        String
  nivel         String?
  profesorGuiaId String?
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())

  colegio       Colegio   @relation(fields: [colegioId], references: [id])
  profesorGuia  Usuario?  @relation(fields: [profesorGuiaId], references: [id])
  alumnos       Alumno[]
  horarios      Horario[]
  tareas        Tarea[]
  anuncios      Anuncio[]
  cursos        Curso[]

  @@unique([colegioId, nombre])
  @@index([colegioId])
}

model Materia {
  id            String   @id @default(cuid())
  colegioId     String
  nombre        String
  profesorId    String?
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())

  colegio       Colegio    @relation(fields: [colegioId], references: [id])
  profesor      Usuario?   @relation(fields: [profesorId], references: [id])
  calificaciones Calificacion[]
  horarios      Horario[]
  asistencias   Asistencia[]
  cursos        Curso[]

  @@unique([colegioId, nombre])
}

model Horario {
  id          String   @id @default(cuid())
  colegioId   String
  gradoId     String
  materiaId   String?
  diaSemana   Int      // 1=Lunes..7=Domingo
  horaInicio  String   // "07:00"
  horaFin     String   // "08:00"
  aula        String?
  createdAt   DateTime @default(now())

  colegio     Colegio  @relation(fields: [colegioId], references: [id])
  grado       Grado    @relation(fields: [gradoId], references: [id])
  materia     Materia? @relation(fields: [materiaId], references: [id])

  @@index([colegioId, gradoId])
  @@index([diaSemana])
}

model Tarea {
  id            String   @id @default(cuid())
  colegioId     String
  gradoId       String
  materia       String
  titulo        String
  descripcion   String?
  fechaEntrega  DateTime
  tipo          String   @default("tarea")
  archivos      String[]
  creadoPor     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  colegio       Colegio        @relation(fields: [colegioId], references: [id])
  grado         Grado          @relation(fields: [gradoId], references: [id])
  creador       Usuario        @relation("TareaCreador", fields: [creadoPor], references: [id])
  entregas      EntregaTarea[]

  @@index([colegioId, gradoId])
  @@index([fechaEntrega])
}

model EntregaTarea {
  id              String       @id @default(cuid())
  colegioId       String
  tareaId         String
  alumnoId        String
  estado          EstadoTarea  @default(PENDIENTE)
  archivos        String[]
  nota            Float?
  comentario      String?
  fechaEntrega    DateTime?
  calificadoAt    DateTime?
  createdAt       DateTime     @default(now())

  colegio         Colegio      @relation(fields: [colegioId], references: [id])
  tarea           Tarea        @relation(fields: [tareaId], references: [id])
  alumno          Alumno       @relation(fields: [alumnoId], references: [id])

  @@unique([tareaId, alumnoId])
  @@index([colegioId, alumnoId])
}

model Asistencia {
  id            String         @id @default(cuid())
  colegioId     String
  alumnoId      String
  materiaId     String?
  fecha         DateTime
  estado        TipoAsistencia
  justificacion String?
  registradoPor String
  createdAt     DateTime       @default(now())

  colegio       Colegio        @relation(fields: [colegioId], references: [id])
  alumno        Alumno         @relation(fields: [alumnoId], references: [id])
  materia       Materia?       @relation(fields: [materiaId], references: [id])
  registrador   Usuario        @relation("AsistenciaRegistrador", fields: [registradoPor], references: [id])

  @@unique([colegioId, alumnoId, fecha, materiaId])
  @@index([colegioId, fecha])
}

model Calificacion {
  id          String   @id @default(cuid())
  colegioId   String
  alumnoId    String
  materiaId   String
  bimestre    Int      // 1,2,3,4
  nota        Float
  tipo        String   @default("parcial")
  registradoPor String
  createdAt   DateTime @default(now())

  colegio     Colegio  @relation(fields: [colegioId], references: [id])
  alumno      Alumno   @relation(fields: [alumnoId], references: [id])
  materia     Materia  @relation(fields: [materiaId], references: [id])
  registrador Usuario  @relation(fields: [registradoPor], references: [id])

  @@index([colegioId, alumnoId, bimestre])
  @@index([colegioId, materiaId, bimestre])
}

model Mensualidad {
  id            String     @id @default(cuid())
  colegioId     String
  alumnoId      String
  mes           String     // "2026-03"
  monto         Float
  estado        EstadoPago @default(PENDIENTE)
  fechaPago     DateTime?
  comprobanteUrl String?
  recurrenteCheckoutId String?
  recurrentePaymentId  String?
  liquidado     Boolean    @default(false)
  comisionPlataforma Float?
  payoutBatchId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  colegio       Colegio    @relation(fields: [colegioId], references: [id])
  alumno        Alumno     @relation(fields: [alumnoId], references: [id])

  @@unique([colegioId, alumnoId, mes])
  @@index([colegioId, mes])
  @@index([estado])
}

model PagoCheckout {
  id            String   @id @default(cuid())
  colegioId     String
  checkoutId    String   @unique
  metadata      Json
  monto         Float
  estado        String   @default("pendiente")
  recurrenteData Json?
  createdAt     DateTime @default(now())

  colegio       Colegio  @relation(fields: [colegioId], references: [id])

  @@index([colegioId])
  @@index([checkoutId])
}

model Anuncio {
  id          String     @id @default(cuid())
  colegioId   String
  titulo      String
  contenido   String
  tipo        TipoAnuncio @default(GENERAL)
  gradoId     String?
  enviarWhatsapp Boolean  @default(false)
  enviarEmail Boolean     @default(false)
  archivos    String[]
  creadoPor   String
  createdAt   DateTime   @default(now())

  colegio     Colegio    @relation(fields: [colegioId], references: [id])
  grado       Grado?     @relation(fields: [gradoId], references: [id])
  creador     Usuario    @relation("AnuncioCreador", fields: [creadoPor], references: [id])

  @@index([colegioId, createdAt(sort: Desc)])
}

model Mensaje {
  id              String   @id @default(cuid())
  colegioId       String
  remitenteId     String
  destinatarioId  String
  contenido       String
  leido           Boolean  @default(false)
  createdAt       DateTime @default(now())

  colegio         Colegio  @relation(fields: [colegioId], references: [id])
  remitente       Usuario  @relation("MensajeRemitente", fields: [remitenteId], references: [id])
  destinatario    Usuario  @relation("MensajeDestinatario", fields: [destinatarioId], references: [id])

  @@index([colegioId, destinatarioId, leido])
}

model Documento {
  id          String   @id @default(cuid())
  colegioId   String
  tipo        String
  titulo      String
  url         String
  tamanoBytes Int?
  creadoPor   String
  createdAt   DateTime @default(now())

  colegio     Colegio  @relation(fields: [colegioId], references: [id])
  creador     Usuario  @relation(fields: [creadoPor], references: [id])

  @@index([colegioId, tipo])
}

model NotificacionProgramada {
  id           String                  @id @default(cuid())
  colegioId    String
  titulo       String
  mensaje      String
  canal        String                  @default("WHATSAPP")
  frecuencia   FrecuenciaNotificacion  @default(UNA_SOLA_VEZ)
  hora         String                  // "HH:mm"
  diaSemana    Int?                    // 1=Lunes..7=Domingo (para SEMANAL)
  diaMes       Int?                    // 1..31 (para MENSUAL)
  roles        String[]                // roles destino: ADMIN_COLEGIO, PROFESOR, PADRE, ALUMNO
  telefonos    String[]                // numeros explicitos adicionales
  activa       Boolean                 @default(true)
  ultimoEnvioAt DateTime?
  proximoEnvioAt DateTime?
  enviadoVeces Int                     @default(0)
  creadoPor    String
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  colegio      Colegio  @relation(fields: [colegioId], references: [id])
  creador      Usuario  @relation("NotificacionCreador", fields: [creadoPor], references: [id])

  @@index([colegioId, activa])
  @@index([proximoEnvioAt])
}

model Curso {
  id          String   @id @default(cuid())
  colegioId   String
  gradoId     String
  materiaId   String?
  profesorId  String?
  nombre      String
  descripcion String?
  color       String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  colegio     Colegio        @relation(fields: [colegioId], references: [id])
  grado       Grado          @relation(fields: [gradoId], references: [id])
  materia     Materia?       @relation(fields: [materiaId], references: [id])
  profesor    Usuario?       @relation("CursoProfesor", fields: [profesorId], references: [id])
  materiales  Material[]
  posts       MuroPost[]
  sesiones    SesionEnVivo[]
  evaluaciones Evaluacion[]

  @@unique([colegioId, gradoId, materiaId])
  @@index([colegioId])
  @@index([profesorId])
}

model Material {
  id          String   @id @default(cuid())
  colegioId   String
  cursoId     String
  titulo      String
  descripcion String?
  tipo        String   @default("ARCHIVO")
  key         String?
  url         String?
  creadoPor   String
  createdAt   DateTime @default(now())

  colegio     Colegio  @relation(fields: [colegioId], references: [id])
  curso       Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  creador     Usuario  @relation(fields: [creadoPor], references: [id])

  @@index([colegioId, cursoId])
}

model MuroPost {
  id          String   @id @default(cuid())
  colegioId   String
  cursoId     String
  autorId     String
  contenido   String
  archivos    String[]
  createdAt   DateTime @default(now())

  colegio     Colegio          @relation(fields: [colegioId], references: [id])
  curso       Curso            @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  autor       Usuario          @relation(fields: [autorId], references: [id])
  comentarios MuroComentario[]

  @@index([colegioId, cursoId, createdAt])
}

model MuroComentario {
  id        String   @id @default(cuid())
  postId    String
  autorId   String
  contenido String
  createdAt DateTime @default(now())

  post      MuroPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  autor     Usuario  @relation(fields: [autorId], references: [id])

  @@index([postId])
}

model SesionEnVivo {
  id          String   @id @default(cuid())
  colegioId   String
  cursoId     String
  titulo      String
  descripcion String?
  fecha       DateTime
  duracionMin Int      @default(60)
  proveedor   String   @default("JITSI")
  url         String
  creadoPor   String
  createdAt   DateTime @default(now())

  colegio     Colegio  @relation(fields: [colegioId], references: [id])
  curso       Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  creador     Usuario  @relation(fields: [creadoPor], references: [id])

  @@index([colegioId, cursoId, fecha])
}

enum TipoPregunta {
  OPCION_MULTIPLE
  VERDADERO_FALSO
  RESPUESTA_CORTA
}

model Evaluacion {
  id           String   @id @default(cuid())
  colegioId    String
  cursoId      String
  titulo       String
  descripcion  String?
  tipo         String   @default("QUIZ")
  puntajeTotal Float    @default(100)
  intentosMax  Int      @default(1)
  publicado    Boolean  @default(true)
  creadoPor    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  colegio      Colegio             @relation(fields: [colegioId], references: [id])
  curso        Curso               @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  creador      Usuario             @relation("EvaluacionCreador", fields: [creadoPor], references: [id])
  preguntas    Pregunta[]
  intentos     IntentoEvaluacion[]

  @@index([colegioId, cursoId])
}

model Pregunta {
  id                String       @id @default(cuid())
  evaluacionId      String
  orden             Int          @default(0)
  enunciado         String
  tipo              TipoPregunta @default(OPCION_MULTIPLE)
  opciones          String[]
  respuestaCorrecta String
  puntaje           Float        @default(1)

  evaluacion        Evaluacion   @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)

  @@index([evaluacionId])
}

model IntentoEvaluacion {
  id           String    @id @default(cuid())
  colegioId    String
  evaluacionId String
  usuarioId    String
  respuestas   Json      @default("{}")
  nota         Float?
  estado       String    @default("ENVIADO")
  iniciadoAt   DateTime  @default(now())
  finalizadoAt DateTime?

  colegio      Colegio    @relation(fields: [colegioId], references: [id])
  evaluacion   Evaluacion @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)
  usuario      Usuario    @relation(fields: [usuarioId], references: [id])

  @@index([evaluacionId, usuarioId])
}
